# ============================================
# QoderWake Coolify Deployment - Configuration
# ============================================

# (Required) Your Qoder Personal Access Token
# Generate at: https://qoder.com → Account Settings → Personal Access Tokens
QODER_PERSONAL_ACCESS_TOKEN=your-token-here

# (Optional) Port to expose QoderWake on the host
# Default: 19820
QODERWAKE_PORT=19820

# (Optional) Host binding inside the container
# Default: 0.0.0.0 (all interfaces - required for Docker networking)
QODERWAKE_HOST=0.0.0.0

# (Required) EverMeMOS / EverOS API key
# This is where the key is STORED, and it reaches the QoderWake daemon only.
# It does NOT by itself configure the memory MCP server: `everos` is a stdio
# connector, and stdio connectors do not inherit container env vars.
# You must ALSO paste this same literal key into the connector's own env block
# (Console -> Waker -> Connectors -> everos -> Environment -> EVERMEMOS_API_KEY).
# Using ${env:EVEROS_API_KEY} there does NOT work -- it is sent verbatim and
# causes 401. See README -> "MCP Connector Environment Variables".
EVEROS_API_KEY=your-everos-api-key-here
