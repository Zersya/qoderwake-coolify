# ============================================
# QoderWake Coolify Deployment - Configuration
# ============================================

# (Required) Your Qoder Personal Access Token
# Generate at: https://qoder.com → Account Settings → Personal Access Tokens
QODER_PERSONAL_ACCESS_TOKEN=your-token-here

# (Optional) Port to expose QoderWake on the host
# Default: 19820
QODERWAKE_PORT=19820

# (Optional) Host binding inside the container
# Default: 0.0.0.0 (all interfaces - required for Docker networking)
QODERWAKE_HOST=0.0.0.0

# (Required) EverMeMOS / EverOS API key
# entrypoint.sh writes it into a mode-600 volume file at container start
# (~/.qoderwake/.everos/credentials.env), and evermemos-launch.sh injects it
# into the `everos` connector process. After deploying, point the connector's
# Command at /home/qoderwake/.qoderwake/bin/evermemos-launch.sh (empty args/env).
# Do NOT try ${env:EVEROS_API_KEY} in the connector env -- QoderWake sends it
# verbatim (401), and the Console UI rejects env keys like EVERMEMOS_API_KEY.
# See README -> "MCP Connector Environment Variables".
EVEROS_API_KEY=your-everos-api-key-here
